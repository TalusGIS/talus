# OIDC / Keycloak — copy to .env.local to override. All optional for local dev
# (oidcConfig.ts has matching localhost defaults).
VITE_OIDC_AUTHORITY=http://localhost:8080/realms/talus
VITE_OIDC_CLIENT_ID=talus-portal
VITE_OIDC_REDIRECT_URI=http://localhost:5173/
VITE_OIDC_POST_LOGOUT_REDIRECT_URI=http://localhost:5173/
VITE_OIDC_SCOPE=openid profile email

# Talus API base URL (Layer 3+). Defaults to the local api in code.
VITE_API_BASE_URL=http://localhost:8000

# Basemap PMTiles archive (Layer 4) — DEV ONLY. Defaults to /basemap.pmtiles (served
# from web/public, generated by scripts/basemap/extract-basemap-pmtiles.sh). Production
# discovers the provisioned archive at runtime via GET /basemap and ignores this.
VITE_BASEMAP_PMTILES_URL=/basemap.pmtiles

# USGS aerial imagery basemap option (Talus 18d). EXTERNAL dependency (public-domain NAIP via
# The National Map). Defaults to on. Set to "off" for AIR-GAPPED deployments to hide the option
# entirely (offline builds can't reach it). Vector flavors + the rest of the map are unaffected.
VITE_IMAGERY_BASEMAP=on
